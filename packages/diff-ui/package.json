{
  "name": "@diffs/diff-ui",
  "version": "0.3.0",
  "description": "The diff views, in one place: the same rendering on the website, the local viewer, and anything else that shows a comparison.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./highlight": "./src/lib/highlight.ts",
    "./revision-tone": "./src/lib/revision-tone.ts",
    "./primitives": "./src/lib/primitives.tsx",
    "./cn": "./src/lib/cn.ts"
  },
  "dependencies": {
    "@diffs/i18n": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "@diffs/core-code": "workspace:*",
    "@diffs/core-pdf": "workspace:*",
    "@diffs/core-text": "workspace:*",
    "@diffs/core-xlsx": "workspace:*",
    "@diffs/engine-bundle": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.545.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
