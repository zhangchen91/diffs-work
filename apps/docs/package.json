    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.0",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
