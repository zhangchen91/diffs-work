# Cloudflare Pages *merges* every matching rule; it does not override. A `/*` rule that sets
# `cache-control` is appended to every more specific rule, so hashed assets came back as
#   max-age=0, must-revalidate, no-transform, max-age=31536000, immutable
# — two contradictory directives in one value. `/*` therefore carries no cache-control, and each
# path that needs one says so. (The website learned this the hard way; see its _headers.)
/*
  vary: accept-encoding
  # Cloudflare's brotli stream for this document decodes to nothing on clients that offer
  # `br` (Safari first), which is a blank page. gzip and deflate are fine, so ask for an
  # unmodified body instead.
  content-encoding: identity

/*.html
  cache-control: public, max-age=0, must-revalidate, no-transform

/index.html
  cache-control: public, max-age=0, must-revalidate, no-transform

/en/index.html
  cache-control: public, max-age=0, must-revalidate, no-transform

# Astro emits every asset with a content hash in its name, so a given URL never changes meaning.
/_astro/*
  cache-control: public, max-age=31536000, immutable

# The search index is regenerated by every build and is fetched by path, not by hash.
/search-index.json
  cache-control: public, max-age=0, must-revalidate

/search.js
  cache-control: public, max-age=0, must-revalidate
