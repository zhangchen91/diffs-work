---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
const docs = await getCollection("docs");
const mine = docs.filter((d) => d.id.startsWith("en/")).sort((a, b) => a.data.order - b.data.order);
const start = mine.filter((d) => d.data.group === "Start")[0] ?? mine[0];
---
<Base title="diffs.work docs — local-first diff" lang="en" altHref="/">
  <main class="mx-auto max-w-5xl px-5 py-16">
    <div class="text-[12px] font-semibold uppercase tracking-[0.2em] text-[#6ee7b7]/80">Documentation</div>
    <h1 class="mt-3 text-[38px] font-semibold leading-tight tracking-tight text-white">Diffs, the shared language of people and agents</h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-7 text-slate-400">
      Local-first, zero upload, WASM split per file family. The interface ships in English and Simplified Chinese.
    </p>
    <div class="mt-8 flex gap-3">
      <a class="rounded-lg bg-[#6ee7b7] px-4 py-2.5 text-[14px] font-medium text-emerald-950" href={`/${start.id}/`}>Quick start</a>
      <a class="rounded-lg border border-[#1e222d] px-4 py-2.5 text-[14px] text-slate-200" href="/en/reference/tool-contract/">Contract</a>
      <a class="rounded-lg border border-[#1e222d] px-4 py-2.5 text-[14px] text-slate-200" href="/">中文</a>
    </div>
    <div class="mt-14 grid gap-3 sm:grid-cols-2">
      {mine.map((d) => (
        <a class="rounded-xl border border-[#1e222d] bg-[#0b0d13] p-5 transition-colors hover:border-slate-600" href={`/${d.id}/`}>
          <div class="text-[11px] uppercase tracking-[0.16em] text-slate-500">{d.data.group}</div>
          <div class="mt-1 text-[15px] font-semibold text-white">{d.data.title}</div>
          <div class="mt-1.5 text-[13px] leading-6 text-slate-400">{d.data.description}</div>
        </a>
      ))}
    </div>
  </main>
</Base>
