{
  "name": "@diffs/website",
  "version": "0.1.0",
  "private": true,
  "description": "diffs.work website — Cloudflare Pages (project: diffs-work).",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5180 --strictPort",
    "lint": "tsc -p tsconfig.json --noEmit",
    "deploy": "pnpm build && node ./scripts/deploy.mjs",
    "deploy:preview": "pnpm build && node ./scripts/deploy.mjs --branch preview"
  },
  "dependencies": {
    "@diffs/core-code": "workspace:*",
    "@diffs/core-text": "workspace:*",
    "@diffs/diff-core": "workspace:*",
    "@diffs/dom-utils": "workspace:*",
    "@diffs/engine-bundle": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "@diffs/core-xlsx": "workspace:*",
    "@diffs/core-markdown": "workspace:*",
    "@diffs/core-code-ast": "workspace:*",
    "@diffs/i18n": "workspace:*",
    "@diffs/mf2": "workspace:*",
    "@diffs/core-pdf": "workspace:*",
    "@diffs/diff-ui": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
