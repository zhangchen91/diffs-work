{
  "name": "diffs.work",
  "private": true,
  "version": "0.1.0",
  "description": "diffs.work — diff everything in your browser. Local-first, WASM-first, zero upload.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:website": "pnpm --filter @diffs/website dev",
    "dev:docs": "pnpm --filter @diffs/docs dev",
    "dev:local": "pnpm --filter @diffs/local dev",
    "build": "pnpm build:website && pnpm build:docs && pnpm build:local && pnpm build:plugin && pnpm build:cli",
    "build:website": "node scripts/sync-examples.mjs && pnpm --filter @diffs/website build",
    "build:docs": "pnpm --filter @diffs/docs build",
    "build:local": "node scripts/sync-local.mjs && pnpm --filter @diffs/local build",
    "build:plugin": "node scripts/build-dsh-plugin.mjs",
    "local": "pnpm build:local && pnpm build:cli && node apps/cli/lib/bin.js local",
    "inbox": "pnpm build:local && pnpm build:cli && node apps/cli/lib/bin.js inbox --open",
    "sync:engine": "node scripts/sync-engine.mjs",
    "sync:examples": "node scripts/sync-examples.mjs",
    "deploy": "pnpm --filter @diffs/website deploy",
    "deploy:docs": "pnpm --filter @diffs/docs deploy",
    "test": "pnpm test:diff && pnpm test:xlsx && pnpm test:core && pnpm test:mf2 && pnpm test:website && pnpm test:pdf && pnpm test:local && pnpm typecheck:sdk && pnpm test:mcp && pnpm test:mcp-verify && pnpm test:docs && pnpm test:doccmds && pnpm test:docstruth && pnpm test:rules && pnpm test:acceptance && pnpm test:rules:src && pnpm test:ui && pnpm test:mobile && pnpm test:layout && pnpm test:docs && pnpm test:doccmds && pnpm test:docstruth && pnpm test:extension && pnpm --filter @diffs/dsh-plugin test",
    "test:diff": "node scripts/test-diff-core.mjs",
    "test:extension": "node --test apps/chrome-extension/test/*.test.mjs",
    "verify": "pnpm build && pnpm test && pnpm --filter @diffs/chrome-extension build",
    "build:xlsx-test": "node scripts/build-xlsx-test.mjs",
    "test:xlsx": "node scripts/build-xlsx-test.mjs && node scripts/run-tests.mjs packages/core-xlsx/test/*.test.mjs",
    "test:website": "node scripts/build-website-test.mjs && node scripts/run-tests.mjs apps/website/test/*.test.mjs",
    "test:core": "node scripts/build-core-tests.mjs && node scripts/run-tests.mjs packages/core-markdown/test/*.test.mjs packages/core-code-ast/test/*.test.mjs packages/core-xml/test/*.test.mjs",
    "test:mf2": "node scripts/build-mf2-test.mjs && node scripts/run-tests.mjs packages/mf2/test/*.test.mjs",
    "build:rules": "node scripts/build-rules-core.mjs",
    "test:rules": "node scripts/run-tests.mjs apps/website/test/kernel/*.test.mjs",
    "test:local": "node scripts/run-tests.mjs apps/local/test/*.test.mjs",
    "test:pdf": "node scripts/build-pdf-test.mjs && node scripts/run-tests.mjs packages/core-pdf/test/*.test.mjs",
    "test:ui": "pnpm --filter @diffs/website build && node scripts/test-ui.mjs",
    "fetch:engine": "node scripts/fetch-engine.mjs",
    "ci:build": "pnpm build:rules || true && (pnpm sync:engine || pnpm fetch:engine || true) && pnpm build",
    "prebuild": "node scripts/sync-examples.mjs && node scripts/ensure-engine.mjs",
    "test:ui:playwright": "node scripts/test-ui-playwright.mjs",
    "test:rules:src": "node scripts/run-kernel-src-tests.mjs",
    "prepare": "node scripts/install-engines.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "test:samples": "node scripts/test-samples-online.mjs",
    "test:mcp": "pnpm build:cli && node scripts/run-tests.mjs apps/cli/test/*.test.mjs",
    "test:docs": "pnpm --filter @diffs/docs build && node scripts/check-docs.mjs",
    "check:drift": "node scripts/check-view-drift.mjs",
    "typecheck:sdk": "pnpm --filter @diffs/diff-tool typecheck",
    "test:acceptance": "node scripts/all-ops-check.mjs",
    "test:mobile": "pnpm --filter @diffs/website build && node scripts/check-mobile.mjs",
    "test:layout": "pnpm --filter @diffs/website build && node scripts/check-layout-switch.mjs",
    "test:mcp-verify": "node scripts/verify-mcp.mjs",
    "test:doccmds": "node scripts/check-docs-commands.mjs",
    "check:clone": "node scripts/check-clean-clone.mjs",
    "check:release": "pnpm test && pnpm check:clone",
    "test:docstruth": "node scripts/check-docs-truth.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.31.0",
    "esbuild": "^0.28.2"
  }
}
